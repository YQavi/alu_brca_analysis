# Raw and processed data - never track, at any nesting depth
**/data/raw/**
**/data/processed/**

# Exceptions: small reference/tracking files worth versioning even under data/raw
!**/data/raw/accession_map_verified.tsv
!**/data/raw/*_verified.tsv

# Compiled/binary sequencing formats, wherever they appear
*.bam
*.bai
*.sra

# Python cache
__pycache__/
*.pyc

# R temporary files
.Rhistory
.RData

# Large regenerable intermediates that don't belong in git regardless of directory
**/salmon_quant/**
**/fimo_results/**/*.gff
**/fimo_results/**/*.xml
**/alu_survival_expr_raw.json
**/alu_survival_expr_long.tsv
